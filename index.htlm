```html
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio & Data Diri | Muhammad Fadly</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome untuk Ikon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#2563eb',
                        secondary: '#0f172a',
                        accent: '#3b82f6'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-blue-600 selection:text-white">

    <!-- Notifikasi Toast Custom (Pengganti alert()) -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- Navbar / Header -->
    <header class="sticky top-0 z-40 bg-white/85 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-center justify-between py-3.5 gap-3">
                <!-- Brand / Logo -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-md shadow-blue-500/20">
                        MF
                    </div>
                    <div>
                        <h1 id="nav-name" class="font-bold text-slate-900 text-base sm:text-lg leading-tight">Muhammad Fadly</h1>
                        <p class="text-xs text-slate-500 font-medium">Personal Portfolio & CV</p>
                    </div>
                </div>

                <!-- Tombol Aksi Utama (Menu Identitas & Update Data Portofolio) -->
                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                    <!-- Tombol Menu Identitas (Dilindungi Token) -->
                    <button onclick="openTokenModal()" class="inline-flex items-center gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 active:scale-95 text-white text-xs sm:text-sm font-semibold transition-all shadow-sm">
                        <i class="fa-solid fa-lock text-amber-400"></i>
                        <span>Menu Identitas</span>
                    </button>

                    <!-- Tombol Menu Update Data Utama -->
                    <button onclick="openPortfolioModal()" class="inline-flex items-center gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white text-xs sm:text-sm font-semibold transition-all shadow-md shadow-blue-600/20">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span>Isi / Update Data</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Hero Section & Kontak -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-blue-950 text-white py-12 sm:py-16">
        <!-- Dekorasi Latar Belakang -->
        <div class="absolute inset-0 opacity-10 pointer-events-none">
            <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-blue-500 blur-3xl"></div>
            <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-indigo-500 blur-3xl"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
                <!-- Profil Singkat -->
                <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-6 max-w-2xl">
                    <div class="relative shrink-0">
                        <img id="hero-avatar" src="https://placehold.co/160x160/1e293b/ffffff?text=MF" alt="Foto Profil" onerror="this.src='https://placehold.co/160x160/1e293b/ffffff?text=MF'" class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl object-cover border-4 border-white/15 shadow-xl">
                        <span class="absolute -bottom-2 -right-2 bg-emerald-500 text-white text-[10px] font-bold px-2.5 py-1 rounded-full border-2 border-slate-900 shadow">
                            AKTIF
                        </span>
                    </div>
                    <div>
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-blue-200 text-xs font-medium mb-3">
                            <i class="fa-solid fa-id-card"></i>
                            <span>Portofolio Digital & Rekam Jejak</span>
                        </div>
                        <h2 id="hero-name" class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white mb-2">
                            Muhammad Fadly
                        </h2>
                        <p id="hero-bio" class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
                            Selamat datang di halaman portofolio pribadi saya. Halaman ini memuat ringkasan prestasi, keahlian, riwayat pendidikan, kesehatan, pengalaman organisasi, serta karya dan produk yang telah saya kembangkan.
                        </p>
                        <!-- Status Akses Identitas -->
                        <div id="identity-badge-status" class="inline-flex items-center gap-2 text-xs bg-amber-500/20 border border-amber-400/30 text-amber-200 px-3 py-1.5 rounded-xl">
                            <i class="fa-solid fa-shield-halved"></i>
                            <span>Data Identitas Pribadi Terkunci (Klik "Menu Identitas" untuk membuka)</span>
                        </div>
                    </div>
                </div>

                <!-- Kartu Kontak & Sosial Media -->
                <div class="w-full lg:w-auto bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-5 sm:p-6 shadow-xl">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-blue-300 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-address-book"></i> Kontak & Sosial Media
                    </h3>
                    <div class="flex flex-col gap-3 min-w-[260px]">
                        <!-- WhatsApp -->
                        <a href="https://wa.me/62895327612432" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3.5 p-3 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/30 transition-all group">
                            <div class="w-10 h-10 rounded-xl bg-emerald-500 flex items-center justify-center text-white text-lg shrink-0 group-hover:scale-105 transition-transform">
                                <i class="fa-brands fa-whatsapp"></i>
                            </div>
                            <div>
                                <p class="text-[11px] text-emerald-200 font-medium">WhatsApp / Telepon</p>
                                <p class="text-sm font-bold text-white">0895327612432</p>
                            </div>
                        </a>

                        <!-- Instagram -->
                        <a href="https://instagram.com/mh.fadlyy" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3.5 p-3 rounded-xl bg-pink-600/20 hover:bg-pink-600/30 border border-pink-500/30 transition-all group">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 via-pink-500 to-purple-600 flex items-center justify-center text-white text-lg shrink-0 group-hover:scale-105 transition-transform">
                                <i class="fa-brands fa-instagram"></i>
                            </div>
                            <div>
                                <p class="text-[11px] text-pink-200 font-medium">Instagram</p>
                                <p class="text-sm font-bold text-white">@mh.fadlyy</p>
                            </div>
                        </a>

                        <!-- TikTok -->
                        <a href="https://www.tiktok.com/@muhmdf4" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3.5 p-3 rounded-xl bg-slate-700/50 hover:bg-slate-700/80 border border-white/15 transition-all group">
                            <div class="w-10 h-10 rounded-xl bg-black flex items-center justify-center text-white text-lg shrink-0 border border-white/20 group-hover:scale-105 transition-transform">
                                <i class="fa-brands fa-tiktok"></i>
                            </div>
                            <div>
                                <p class="text-[11px] text-slate-300 font-medium">TikTok</p>
                                <p class="text-sm font-bold text-white">@muhmdf4</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Panel Identitas Terbuka (Muncul di halaman utama setelah Token "MuhammadF" dimasukkan) -->
    <section id="unlocked-identity-section" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
        <div class="bg-white rounded-2xl border-2 border-blue-500/30 shadow-lg p-6 sm:p-8 relative overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <div>
                        <h3 class="text-lg sm:text-xl font-bold text-slate-900">Biodata & Identitas Lengkap</h3>
                        <p class="text-xs text-slate-500">Akses terverifikasi menggunakan token keamanan</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="openIdentityFormModal()" class="px-3.5 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold transition-colors flex items-center gap-1.5">
                        <i class="fa-solid fa-pen"></i> Edit Identitas
                    </button>
                    <button onclick="lockIdentity()" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors flex items-center gap-1.5">
                        <i class="fa-solid fa-lock"></i> Kunci Kembali
                    </button>
                </div>
            </div>

            <div id="identity-display-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Diisi dinamis oleh JavaScript -->
            </div>
        </div>
    </section>

    <!-- Navigasi Cepat Kategori Halaman Utama -->
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
        <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar">
            <a href="#sec-prestasi" class="shrink-0 px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:text-blue-600 text-xs sm:text-sm font-semibold text-slate-700 shadow-sm transition-all">
                <i class="fa-solid fa-trophy text-amber-500 mr-1.5"></i>Prestasi
            </a>
            <a href="#sec-keahlian" class="shrink-0 px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:text-blue-600 text-xs sm:text-sm font-semibold text-slate-700 shadow-sm transition-all">
                <i class="fa-solid fa-bolt text-blue-500 mr-1.5"></i>Keahlian
            </a>
            <a href="#sec-pendidikan" class="shrink-0 px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:text-blue-600 text-xs sm:text-sm font-semibold text-slate-700 shadow-sm transition-all">
                <i class="fa-solid fa-graduation-cap text-indigo-500 mr-1.5"></i>Riwayat Pendidikan
            </a>
            <a href="#sec-penyakit" class="shrink-0 px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:text-blue-600 text-xs sm:text-sm font-semibold text-slate-700 shadow-sm transition-all">
                <i class="fa-solid fa-notes-medical text-rose-500 mr-1.5"></i>Riwayat Penyakit
            </a>
            <a href="#sec-organisasi" class="shrink-0 px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:text-blue-600 text-xs sm:text-sm font-semibold text-slate-700 shadow-sm transition-all">
                <i class="fa-solid fa-users text-emerald-500 mr-1.5"></i>Pengalaman Organisasi
            </a>
            <a href="#sec-karya" class="shrink-0 px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-blue-500 hover:text-blue-600 text-xs sm:text-sm font-semibold text-slate-700 shadow-sm transition-all">
                <i class="fa-solid fa-layer-group text-purple-500 mr-1.5"></i>Karya / Produk
            </a>
        </div>
    </nav>

    <!-- Konten Utama Portofolio (6 Bagian Utama) -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- Baris 1: Prestasi & Keahlian -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- 1. Prestasi -->
            <section id="sec-prestasi" class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-5">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-lg">
                                <i class="fa-solid fa-trophy"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">Prestasi</h3>
                                <p class="text-xs text-slate-500">Penghargaan & pencapaian terbaik</p>
                            </div>
                        </div>
                        <button onclick="openPortfolioModal('prestasi')" class="p-2.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 transition-colors text-xs font-semibold" title="Tambah Prestasi">
                            <i class="fa-solid fa-plus"></i> Tambah
                        </button>
                    </div>
                    <div id="list-prestasi" class="space-y-3">
                        <!-- Diisi oleh JS -->
                    </div>
                </div>
            </section>

            <!-- 2. Keahlian -->
            <section id="sec-keahlian" class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-5">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-lg">
                                <i class="fa-solid fa-bolt"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">Keahlian (Skills)</h3>
                                <p class="text-xs text-slate-500">Kompetensi teknis & non-teknis</p>
                            </div>
                        </div>
                        <button onclick="openPortfolioModal('keahlian')" class="p-2.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 transition-colors text-xs font-semibold" title="Tambah Keahlian">
                            <i class="fa-solid fa-plus"></i> Tambah
                        </button>
                    </div>
                    <div id="list-keahlian" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Diisi oleh JS -->
                    </div>
                </div>
            </section>
        </div>

        <!-- Baris 2: Riwayat Pendidikan & Riwayat Penyakit -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- 3. Riwayat Pendidikan -->
            <section id="sec-pendidikan" class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
                <div class="flex items-center justify-between gap-2 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-slate-900">Riwayat Pendidikan</h3>
                            <p class="text-xs text-slate-500">Jenjang akademik & institusi</p>
                        </div>
                    </div>
                    <button onclick="openPortfolioModal('pendidikan')" class="p-2.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 transition-colors text-xs font-semibold">
                        <i class="fa-solid fa-plus"></i> Tambah
                    </button>
                </div>
                <div id="list-pendidikan" class="relative border-l-2 border-indigo-100 ml-3 space-y-5 pl-6 py-1">
                    <!-- Diisi oleh JS -->
                </div>
            </section>

            <!-- 4. Riwayat Penyakit -->
            <section id="sec-penyakit" class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
                <div class="flex items-center justify-between gap-2 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-notes-medical"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-slate-900">Riwayat Penyakit & Kesehatan</h3>
                            <p class="text-xs text-slate-500">Catatan medis & kondisi kesehatan</p>
                        </div>
                    </div>
                    <button onclick="openPortfolioModal('penyakit')" class="p-2.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 transition-colors text-xs font-semibold">
                        <i class="fa-solid fa-plus"></i> Tambah
                    </button>
                </div>
                <div id="list-penyakit" class="space-y-3">
                    <!-- Diisi oleh JS -->
                </div>
            </section>
        </div>

        <!-- Baris 3: Pengalaman Organisasi -->
        <section id="sec-organisasi" class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
            <div class="flex items-center justify-between gap-2 mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Pengalaman Organisasi</h3>
                        <p class="text-xs text-slate-500">Kepemimpinan, kepanitiaan, dan kontribusi sosial</p>
                    </div>
                </div>
                <button onclick="openPortfolioModal('organisasi')" class="p-2.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 transition-colors text-xs font-semibold">
                    <i class="fa-solid fa-plus"></i> Tambah
                </button>
            </div>
            <div id="list-organisasi" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Diisi oleh JS -->
            </div>
        </section>

        <!-- Baris 4: Karya / Produk -->
        <section id="sec-karya" class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
            <div class="flex items-center justify-between gap-2 mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Karya & Produk</h3>
                        <p class="text-xs text-slate-500">Proyek, aplikasi, desain, atau produk yang telah dibuat</p>
                    </div>
                </div>
                <button onclick="openPortfolioModal('karya')" class="p-2.5 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 transition-colors text-xs font-semibold">
                    <i class="fa-solid fa-plus"></i> Tambah
                </button>
            </div>
            <div id="list-karya" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Diisi oleh JS -->
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-8 mt-12 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="text-center sm:text-left">
                <p class="text-sm font-semibold text-white">Portofolio & Data Diri — <span id="footer-name">Muhammad Fadly</span></p>
                <p class="text-xs text-slate-500 mt-1">WA: 0895327612432 • IG: @mh.fadlyy • TikTok: @muhmdf4</p>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="resetAllData()" class="text-xs text-slate-500 hover:text-rose-400 underline transition-colors">
                    Reset ke Data Awal
                </button>
            </div>
        </div>
    </footer>

    <!-- ===================================================================== -->
    <!-- MODAL 1: VERIFIKASI TOKEN / PASSWORD UNTUK MENU IDENTITAS             -->
    <!-- ===================================================================== -->
    <div id="modal-token" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/70 backdrop-blur-sm p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 transform transition-all">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-key"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Verifikasi Token Identitas</h3>
                        <p class="text-xs text-slate-500">Masukkan password untuk membuka & mengisi data diri</p>
                    </div>
                </div>
                <button onclick="closeModal('modal-token')" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form onsubmit="verifyToken(event)" class="space-y-4">
                <div>
                    <label for="token-input" class="block text-xs font-semibold text-slate-700 mb-1.5">Token / Password Akses</label>
                    <div class="relative">
                        <input type="password" id="token-input" required placeholder="Masukkan token..." class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm pr-10">
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                            <i id="eye-icon" class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <p id="token-error" class="hidden text-xs text-rose-600 font-medium mt-1.5">
                        <i class="fa-solid fa-circle-exclamation mr-1"></i>Token salah! Silakan periksa huruf besar/kecil.
                    </p>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" onclick="closeModal('modal-token')" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-semibold transition-colors">
                        Batal
                    </button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-semibold transition-colors shadow-md">
                        Buka Menu Identitas
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- MODAL 2: FORM PENGISIAN & UPDATE DATA IDENTITAS DIRI                  -->
    <!-- ===================================================================== -->
    <div id="modal-identity-form" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/70 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-100 my-8">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-id-card-clip"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Formulir Data Identitas Diri</h3>
                        <p class="text-xs text-slate-500">Lengkapi atau perbarui biodata pribadi Anda</p>
                    </div>
                </div>
                <button onclick="closeModal('modal-identity-form')" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form onsubmit="saveIdentityData(event)" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Nama Lengkap -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap *</label>
                        <input type="text" id="id-nama" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm" placeholder="Contoh: Muhammad Fadly">
                    </div>

                    <!-- Tanggal Lahir -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Lahir *</label>
                        <input type="date" id="id-tgl-lahir" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm">
                    </div>

                    <!-- Jenis Kelamin -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Jenis Kelamin *</label>
                        <select id="id-jk" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm bg-white">
                            <option value="Laki-laki">Laki-laki</option>
                            <option value="Perempuan">Perempuan</option>
                        </select>
                    </div>

                    <!-- Status -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Status *</label>
                        <select id="id-status" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm bg-white">
                            <option value="Pelajar / Mahasiswa">Pelajar / Mahasiswa</option>
                            <option value="Belum Menikah">Belum Menikah</option>
                            <option value="Menikah">Menikah</option>
                            <option value="Bekerja / Profesional">Bekerja / Profesional</option>
                        </select>
                    </div>

                    <!-- Nama Orang Tua -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Orang Tua (Ayah / Ibu) *</label>
                        <input type="text" id="id-ortu" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm" placeholder="Contoh: Bpk. Ahmad & Ibu Siti">
                    </div>

                    <!-- Hobi -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Hobi *</label>
                        <input type="text" id="id-hobi" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm" placeholder="Contoh: Coding, Desain, Olahraga">
                    </div>
                </div>

                <!-- Alamat Lengkap -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Alamat Lengkap *</label>
                    <textarea id="id-alamat" rows="2" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm" placeholder="Masukkan alamat lengkap domisili saat ini..."></textarea>
                </div>

                <!-- Bio Singkat di Hero -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi Singkat Profil (Tampil di Beranda)</label>
                    <textarea id="id-bio" rows="2" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm" placeholder="Deskripsi singkat mengenai diri Anda..."></textarea>
                </div>

                <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                    <button type="button" onclick="closeModal('modal-identity-form')" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-semibold transition-colors">
                        Tutup
                    </button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-semibold transition-colors shadow-md">
                        <i class="fa-solid fa-floppy-disk mr-1.5"></i>Simpan Identitas
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- MODAL 3: MENU ISI / UPDATE DATA PORTOFOLIO HALAMAN UTAMA              -->
    <!-- ===================================================================== -->
    <div id="modal-portfolio" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/70 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-100 my-8">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-folder-plus"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Kelola & Update Data Portofolio</h3>
                        <p class="text-xs text-slate-500">Tambah item baru atau hapus data pada halaman utama</p>
                    </div>
                </div>
                <button onclick="closeModal('modal-portfolio')" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Pilih Kategori Data -->
            <div class="mb-5">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Pilih Kategori Bagian Halaman Utama</label>
                <select id="pf-category" onchange="renderPortfolioFormFields()" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none text-sm font-semibold bg-slate-50">
                    <option value="prestasi">1. Prestasi</option>
                    <option value="keahlian">2. Keahlian (Skills)</option>
                    <option value="pendidikan">3. Riwayat Pendidikan</option>
                    <option value="penyakit">4. Riwayat Penyakit</option>
                    <option value="organisasi">5. Pengalaman Organisasi</option>
                    <option value="karya">6. Karya / Produk</option>
                </select>
            </div>

            <!-- Form Tambah Data Dinamis -->
            <form onsubmit="addPortfolioItem(event)" class="bg-slate-50 p-4 rounded-xl border border-slate-200/80 space-y-3.5 mb-6">
                <h4 class="text-xs font-bold uppercase tracking-wider text-blue-600">Tambah Data Baru</h4>
                <div id="pf-dynamic-fields" class="space-y-3">
                    <!-- Diisi oleh JS sesuai kategori -->
                </div>
                <div class="pt-1 flex justify-end">
                    <button type="submit" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-semibold transition-colors shadow-sm">
                        <i class="fa-solid fa-plus mr-1"></i> Tambahkan ke Halaman
                    </button>
                </div>
            </form>

            <!-- Daftar Data Saat Ini untuk Kategori Terpilih (Bisa Edit / Hapus) -->
            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2.5">Daftar Data Tersimpan (Klik Hapus untuk Update)</h4>
                <div id="pf-existing-list" class="max-h-56 overflow-y-auto space-y-2 pr-1">
                    <!-- Diisi oleh JS -->
                </div>
            </div>

            <div class="flex justify-end pt-4 mt-4 border-t border-slate-100">
                <button type="button" onclick="closeModal('modal-portfolio')" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-semibold transition-colors">
                    Selesai
                </button>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- JAVASCRIPT LOGIC                                                      -->
    <!-- ===================================================================== -->
    <script>
        // Token / Password Rahasia sesuai permintaan
        const SECRET_TOKEN = "MuhammadF";
        let isIdentityUnlocked = false;

        // Data Awal (Default State)
        const defaultData = {
            identity: {
                nama: "Muhammad Fadly",
                tanggalLahir: "2005-08-17",
                alamat: "Tasikmalaya, Jawa Barat, Indonesia",
                status: "Pelajar / Mahasiswa",
                hobi: "Pemrograman Web, Desain Grafis, Olahraga",
                namaOrangTua: "Bapak H. Ahmad & Ibu Hj. Aminah",
                jenisKelamin: "Laki-laki",
                bio: "Selamat datang di halaman portofolio pribadi saya. Halaman ini memuat ringkasan prestasi, keahlian, riwayat pendidikan, kesehatan, pengalaman organisasi, serta karya dan produk yang telah saya kembangkan."
            },
            prestasi: [
                { id: 1, judul: "Juara 1 Lomba Desain Web Tingkat Kota", tahun: "2025", penyelenggara: "Dinas Pendidikan & Kominfo" },
                { id: 2, judul: "Finalis Olimpiade Sains & Teknologi", tahun: "2024", penyelenggara: "Tingkat Provinsi Jawa Barat" }
            ],
            keahlian: [
                { id: 1, nama: "HTML, CSS & Tailwind", tingkat: "Mahir (90%)" },
                { id: 2, nama: "JavaScript & Web App", tingkat: "Menengah (80%)" },
                { id: 3, nama: "UI/UX & Desain Grafis", tingkat: "Mahir (85%)" },
                { id: 4, nama: "Public Speaking & Leadership", tingkat: "Baik (85%)" }
            ],
            pendidikan: [
                { id: 1, institusi: "Universitas / Perguruan Tinggi", jurusan: "Teknik Informatika", tahun: "2023 - Sekarang" },
                { id: 2, institusi: "SMA / SMK Negeri", jurusan: "IPA / Rekayasa Perangkat Lunak", tahun: "2020 - 2023" },
                { id: 3, institusi: "SMP Negeri", jurusan: "Pendidikan Menengah Pertama", tahun: "2017 - 2020" }
            ],
            penyakit: [
                { id: 1, nama: "Tidak Ada Riwayat Penyakit Berat", tahun: "Sehat", keterangan: "Kondisi fisik prima, tidak memiliki alergi obat maupun makanan tertentu." },
                { id: 2, nama: "Maag Ringan (Gastritis)", tahun: "2022 (Sembuh)", keterangan: "Pernah mengalami gangguan lambung ringan saat jadwal makan tidak teratur, saat ini sudah sembuh total." }
            ],
            organisasi: [
                { id: 1, nama: "Himpunan Mahasiswa Informatika", jabatan: "Koordinator Divisi Kominfo", periode: "2024 - Sekarang", deskripsi: "Mengelola media sosial, publikasi acara, dan pengembangan website organisasi." },
                { id: 2, nama: "OSIS / MPK Sekolah", jabatan: "Ketua Seksi Bidang TIK", periode: "2021 - 2022", deskripsi: "Bertanggung jawab atas dokumentasi digital dan sistem informasi kegiatan sekolah." }
            ],
            karya: [
                { id: 1, judul: "Website Portofolio Interaktif", kategori: "Web Development", deskripsi: "Sistem informasi portofolio pribadi dengan proteksi token keamanan dan manajemen data dinamis.", link: "https://instagram.com/mh.fadlyy" },
                { id: 2, judul: "Aplikasi Kasir UMKM Sederhana", kategori: "Software / Produk", deskripsi: "Aplikasi pencatatan transaksi harian dan stok barang berbasis web yang ringan digunakan.", link: "https://wa.me/62895327612432" },
                { id: 3, judul: "Konten Edukasi Teknologi", kategori: "Kreator Konten", deskripsi: "Seri video pendek berbagi tips seputar teknologi dan pemrograman di TikTok @muhmdf4.", link: "https://www.tiktok.com/@muhmdf4" }
            ]
        };

        // Load data dari localStorage atau gunakan defaultData
        let appData = JSON.parse(localStorage.getItem('mf_portfolio_data_v1')) || JSON.parse(JSON.stringify(defaultData));

        function saveDataToStorage() {
            localStorage.setItem('mf_portfolio_data_v1', JSON.stringify(appData));
        }

        // Fungsi Notifikasi Toast (Pengganti alert)
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-slate-900 border-emerald-500' : (type === 'error' ? 'bg-rose-950 border-rose-500' : 'bg-blue-950 border-blue-500');
            const icon = type === 'success' ? '<i class="fa-solid fa-circle-check text-emerald-400"></i>' : (type === 'error' ? '<i class="fa-solid fa-circle-xmark text-rose-400"></i>' : '<i class="fa-solid fa-circle-info text-blue-400"></i>');

            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border-l-4 ${bgColor} text-white text-xs sm:text-sm font-medium shadow-xl transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `${icon}<span>${message}</span>`;

            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }

        // Kontrol Modal
        function openModal(modalId) {
            const modal = document.getElementById(modalId);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // =====================================================================
        // LOGIKA MENU IDENTITAS & TOKEN ("MuhammadF")
        // =====================================================================
        function openTokenModal() {
            if (isIdentityUnlocked) {
                openIdentityFormModal();
                return;
            }
            document.getElementById('token-input').value = '';
            document.getElementById('token-error').classList.add('hidden');
            openModal('modal-token');
            setTimeout(() => document.getElementById('token-input').focus(), 100);
        }

        function togglePasswordVisibility() {
            const input = document.getElementById('token-input');
            const icon = document.getElementById('eye-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        function verifyToken(event) {
            event.preventDefault();
            const enteredToken = document.getElementById('token-input').value;
            const errorEl = document.getElementById('token-error');

            if (enteredToken === SECRET_TOKEN) {
                isIdentityUnlocked = true;
                errorEl.classList.add('hidden');
                closeModal('modal-token');
                
                // Tampilkan bagian identitas di halaman utama
                renderIdentitySection();
                document.getElementById('unlocked-identity-section').classList.remove('hidden');
                
                // Perbarui badge di Hero
                const badge = document.getElementById('identity-badge-status');
                badge.className = "inline-flex items-center gap-2 text-xs bg-emerald-500/20 border border-emerald-400/30 text-emerald-200 px-3 py-1.5 rounded-xl";
                badge.innerHTML = '<i class="fa-solid fa-lock-open"></i><span>Akses Identitas Terbuka</span>';

                showToast('Token valid! Menu identitas berhasil dibuka.');
                openIdentityFormModal();
            } else {
                errorEl.classList.remove('hidden');
                showToast('Token tidak sesuai!', 'error');
            }
        }

        function lockIdentity() {
            isIdentityUnlocked = false;
            document.getElementById('unlocked-identity-section').classList.add('hidden');
            const badge = document.getElementById('identity-badge-status');
            badge.className = "inline-flex items-center gap-2 text-xs bg-amber-500/20 border border-amber-400/30 text-amber-200 px-3 py-1.5 rounded-xl";
            badge.innerHTML = '<i class="fa-solid fa-shield-halved"></i><span>Data Identitas Pribadi Terkunci (Klik "Menu Identitas" untuk membuka)</span>';
            showToast('Data identitas kembali dikunci.', 'info');
        }

        function openIdentityFormModal() {
            if (!isIdentityUnlocked) {
                openTokenModal();
                return;
            }
            const idData = appData.identity;
            document.getElementById('id-nama').value = idData.nama || '';
            document.getElementById('id-tgl-lahir').value = idData.tanggalLahir || '';
            document.getElementById('id-jk').value = idData.jenisKelamin || 'Laki-laki';
            document.getElementById('id-status').value = idData.status || 'Pelajar / Mahasiswa';
            document.getElementById('id-ortu').value = idData.namaOrangTua || '';
            document.getElementById('id-hobi').value = idData.hobi || '';
            document.getElementById('id-alamat').value = idData.alamat || '';
            document.getElementById('id-bio').value = idData.bio || '';
            openModal('modal-identity-form');
        }

        function saveIdentityData(event) {
            event.preventDefault();
            appData.identity = {
                nama: document.getElementById('id-nama').value.trim(),
                tanggalLahir: document.getElementById('id-tgl-lahir').value,
                jenisKelamin: document.getElementById('id-jk').value,
                status: document.getElementById('id-status').value,
                namaOrangTua: document.getElementById('id-ortu').value.trim(),
                hobi: document.getElementById('id-hobi').value.trim(),
                alamat: document.getElementById('id-alamat').value.trim(),
                bio: document.getElementById('id-bio').value.trim()
            };

            saveDataToStorage();
            renderAll();
            closeModal('modal-identity-form');
            showToast('Data identitas berhasil disimpan dan diperbarui!');
        }

        function formatTanggalIndo(dateStr) {
            if (!dateStr) return '-';
            const bulan = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            const parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;
            return `${parseInt(parts[2], 10)} ${bulan[parseInt(parts[1], 10) - 1]} ${parts[0]}`;
        }

        function renderIdentitySection() {
            const id = appData.identity;
            const grid = document.getElementById('identity-display-grid');
            const items = [
                { label: 'Nama Lengkap', value: id.nama, icon: 'fa-user', color: 'text-blue-600 bg-blue-50' },
                { label: 'Tanggal Lahir', value: formatTanggalIndo(id.tanggalLahir), icon: 'fa-cake-candles', color: 'text-pink-600 bg-pink-50' },
                { label: 'Jenis Kelamin', value: id.jenisKelamin, icon: 'fa-venus-mars', color: 'text-indigo-600 bg-indigo-50' },
                { label: 'Status', value: id.status, icon: 'fa-briefcase', color: 'text-emerald-600 bg-emerald-50' },
                { label: 'Nama Orang Tua', value: id.namaOrangTua, icon: 'fa-people-roof', color: 'text-amber-600 bg-amber-50' },
                { label: 'Hobi', value: id.hobi, icon: 'fa-heart', color: 'text-rose-600 bg-rose-50' },
                { label: 'Alamat Domisili', value: id.alamat, icon: 'fa-location-dot', color: 'text-purple-600 bg-purple-50', span: 'sm:col-span-2' }
            ];

            grid.innerHTML = items.map(item => `
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/70 ${item.span || ''}">
                    <div class="flex items-center gap-2.5 mb-1.5">
                        <span class="w-7 h-7 rounded-lg ${item.color} flex items-center justify-center text-xs">
                            <i class="fa-solid ${item.icon}"></i>
                        </span>
                        <span class="text-xs font-semibold text-slate-500">${item.label}</span>
                    </div>
                    <p class="text-sm font-bold text-slate-900 pl-9">${escapeHTML(item.value || '-')}</p>
                </div>
            `).join('');
        }

        // =====================================================================
        // LOGIKA MENU ISI / UPDATE DATA PORTOFOLIO HALAMAN UTAMA
        // =====================================================================
        function openPortfolioModal(defaultCategory = 'prestasi') {
            document.getElementById('pf-category').value = defaultCategory;
            renderPortfolioFormFields();
            openModal('modal-portfolio');
        }

        function renderPortfolioFormFields() {
            const cat = document.getElementById('pf-category').value;
            const container = document.getElementById('pf-dynamic-fields');

            const fieldTemplates = {
                prestasi: `
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Prestasi / Penghargaan *</label>
                        <input type="text" id="inp-judul" required placeholder="Contoh: Juara 1 Lomba Coding Nasional" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tahun *</label>
                            <input type="text" id="inp-tahun" required placeholder="Contoh: 2025" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Penyelenggara / Tingkat *</label>
                            <input type="text" id="inp-penyelenggara" required placeholder="Contoh: Kemendikbud" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                    </div>
                `,
                keahlian: `
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Keahlian / Skill *</label>
                            <input type="text" id="inp-nama" required placeholder="Contoh: Web Development" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tingkat Penguasaan *</label>
                            <input type="text" id="inp-tingkat" required placeholder="Contoh: Mahir (90%)" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                    </div>
                `,
                pendidikan: `
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Sekolah / Kampus *</label>
                        <input type="text" id="inp-institusi" required placeholder="Contoh: Universitas Indonesia" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Jurusan / Program *</label>
                            <input type="text" id="inp-jurusan" required placeholder="Contoh: Teknik Informatika" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tahun Masuk - Lulus *</label>
                            <input type="text" id="inp-tahun" required placeholder="Contoh: 2023 - Sekarang" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                    </div>
                `,
                penyakit: `
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Riwayat Penyakit / Kondisi *</label>
                            <input type="text" id="inp-nama" required placeholder="Contoh: Tidak ada / Asma ringan" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tahun / Status *</label>
                            <input type="text" id="inp-tahun" required placeholder="Contoh: 2023 (Sembuh)" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Keterangan Medis *</label>
                        <input type="text" id="inp-keterangan" required placeholder="Catatan kondisi kesehatan saat ini..." class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                    </div>
                `,
                organisasi: `
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Organisasi *</label>
                        <input type="text" id="inp-nama" required placeholder="Contoh: Himpunan Mahasiswa" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Jabatan / Posisi *</label>
                            <input type="text" id="inp-jabatan" required placeholder="Contoh: Ketua Divisi" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Periode *</label>
                            <input type="text" id="inp-periode" required placeholder="Contoh: 2024 - 2025" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi Tugas *</label>
                        <input type="text" id="inp-deskripsi" required placeholder="Peran dan kontribusi dalam organisasi..." class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                    </div>
                `,
                karya: `
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Karya / Produk *</label>
                            <input type="text" id="inp-judul" required placeholder="Contoh: Aplikasi Toko Online" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Kategori *</label>
                            <input type="text" id="inp-kategori" required placeholder="Contoh: Website / Produk Digital" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi Karya *</label>
                        <input type="text" id="inp-deskripsi" required placeholder="Penjelasan singkat karya/produk..." class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Tautan / Link (Opsional)</label>
                        <input type="url" id="inp-link" placeholder="https://..." class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600">
                    </div>
                `
            };

            container.innerHTML = fieldTemplates[cat];
            renderExistingListInModal(cat);
        }

        function addPortfolioItem(event) {
            event.preventDefault();
            const cat = document.getElementById('pf-category').value;
            const newId = Date.now();
            let newItem = { id: newId };

            if (cat === 'prestasi') {
                newItem.judul = document.getElementById('inp-judul').value.trim();
                newItem.tahun = document.getElementById('inp-tahun').value.trim();
                newItem.penyelenggara = document.getElementById('inp-penyelenggara').value.trim();
            } else if (cat === 'keahlian') {
                newItem.nama = document.getElementById('inp-nama').value.trim();
                newItem.tingkat = document.getElementById('inp-tingkat').value.trim();
            } else if (cat === 'pendidikan') {
                newItem.institusi = document.getElementById('inp-institusi').value.trim();
                newItem.jurusan = document.getElementById('inp-jurusan').value.trim();
                newItem.tahun = document.getElementById('inp-tahun').value.trim();
            } else if (cat === 'penyakit') {
                newItem.nama = document.getElementById('inp-nama').value.trim();
                newItem.tahun = document.getElementById('inp-tahun').value.trim();
                newItem.keterangan = document.getElementById('inp-keterangan').value.trim();
            } else if (cat === 'organisasi') {
                newItem.nama = document.getElementById('inp-nama').value.trim();
                newItem.jabatan = document.getElementById('inp-jabatan').value.trim();
                newItem.periode = document.getElementById('inp-periode').value.trim();
                newItem.deskripsi = document.getElementById('inp-deskripsi').value.trim();
            } else if (cat === 'karya') {
                newItem.judul = document.getElementById('inp-judul').value.trim();
                newItem.kategori = document.getElementById('inp-kategori').value.trim();
                newItem.deskripsi = document.getElementById('inp-deskripsi').value.trim();
                newItem.link = document.getElementById('inp-link').value.trim();
            }

            appData[cat].unshift(newItem);
            saveDataToStorage();
            renderAll();
            renderPortfolioFormFields();
            showToast('Data berhasil ditambahkan ke halaman utama!');
        }

        function deletePortfolioItem(cat, id) {
            appData[cat] = appData[cat].filter(item => item.id !== id);
            saveDataToStorage();
            renderAll();
            renderExistingListInModal(cat);
            showToast('Item berhasil dihapus.', 'info');
        }

        function renderExistingListInModal(cat) {
            const listEl = document.getElementById('pf-existing-list');
            const items = appData[cat];

            if (!items || items.length === 0) {
                listEl.innerHTML = `<p class="text-xs text-slate-400 italic py-2">Belum ada data pada kategori ini.</p>`;
                return;
            }

            listEl.innerHTML = items.map(item => {
                const title = item.judul || item.nama || item.institusi;
                const sub = item.tahun || item.tingkat || item.periode || item.kategori || '';
                return `
                    <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-white border border-slate-200 text-xs">
                        <div class="truncate">
                            <p class="font-bold text-slate-800 truncate">${escapeHTML(title)}</p>
                            <p class="text-slate-500 text-[11px]">${escapeHTML(sub)}</p>
                        </div>
                        <button type="button" onclick="deletePortfolioItem('${cat}', ${item.id})" class="shrink-0 px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold transition-colors">
                            <i class="fa-solid fa-trash-can"></i> Hapus
                        </button>
                    </div>
                `;
            }).join('');
        }

        // =====================================================================
        // RENDER HALAMAN UTAMA
        // =====================================================================
        function escapeHTML(str) {
            if (!str) return '';
            return String(str).replace(/[&<>'"]/g, tag => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            }[tag]));
        }

        function renderAll() {
            // Update Nama & Bio di Header/Hero/Footer
            const nama = appData.identity.nama || "Muhammad Fadly";
            const inisial = nama.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || "MF";
            document.getElementById('nav-name').textContent = nama;
            document.getElementById('hero-name').textContent = nama;
            document.getElementById('footer-name').textContent = nama;
            document.getElementById('hero-bio').textContent = appData.identity.bio || defaultData.identity.bio;
            document.getElementById('hero-avatar').src = `https://placehold.co/160x160/1e293b/ffffff?text=${encodeURIComponent(inisial)}`;

            if (isIdentityUnlocked) {
                renderIdentitySection();
            }

            // 1. Render Prestasi
            const elPrestasi = document.getElementById('list-prestasi');
            elPrestasi.innerHTML = appData.prestasi.length ? appData.prestasi.map(p => `
                <div class="p-3.5 rounded-xl bg-amber-50/50 border border-amber-200/60 flex items-start justify-between gap-3">
                    <div class="flex items-start gap-3">
                        <span class="mt-0.5 text-amber-500"><i class="fa-solid fa-award"></i></span>
                        <div>
                            <h4 class="text-sm font-bold text-slate-900">${escapeHTML(p.judul)}</h4>
                            <p class="text-xs text-slate-600 mt-0.5">${escapeHTML(p.penyelenggara)}</p>
                        </div>
                    </div>
                    <span class="shrink-0 px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 text-xs font-bold">${escapeHTML(p.tahun)}</span>
                </div>
            `).join('') : '<p class="text-xs text-slate-400 italic">Belum ada data prestasi.</p>';

            // 2. Render Keahlian
            const elKeahlian = document.getElementById('list-keahlian');
            elKeahlian.innerHTML = appData.keahlian.length ? appData.keahlian.map(k => `
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/70 flex flex-col justify-between">
                    <span class="text-sm font-bold text-slate-900">${escapeHTML(k.nama)}</span>
                    <span class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600">
                        <i class="fa-solid fa-circle-check text-[10px]"></i> ${escapeHTML(k.tingkat)}
                    </span>
                </div>
            `).join('') : '<p class="text-xs text-slate-400 italic">Belum ada data keahlian.</p>';

            // 3. Render Riwayat Pendidikan
            const elPendidikan = document.getElementById('list-pendidikan');
            elPendidikan.innerHTML = appData.pendidikan.length ? appData.pendidikan.map(edu => `
                <div class="relative">
                    <span class="absolute -left-[31px] top-1 w-3.5 h-3.5 rounded-full bg-indigo-600 border-4 border-indigo-100"></span>
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h4 class="text-sm font-bold text-slate-900">${escapeHTML(edu.institusi)}</h4>
                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700">${escapeHTML(edu.tahun)}</span>
                    </div>
                    <p class="text-xs text-slate-600 mt-1">${escapeHTML(edu.jurusan)}</p>
                </div>
            `).join('') : '<p class="text-xs text-slate-400 italic">Belum ada data pendidikan.</p>';

            // 4. Render Riwayat Penyakit
            const elPenyakit = document.getElementById('list-penyakit');
            elPenyakit.innerHTML = appData.penyakit.length ? appData.penyakit.map(med => `
                <div class="p-3.5 rounded-xl bg-rose-50/40 border border-rose-200/60">
                    <div class="flex items-center justify-between gap-2 mb-1">
                        <h4 class="text-sm font-bold text-slate-900">${escapeHTML(med.nama)}</h4>
                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-lg bg-rose-100 text-rose-700">${escapeHTML(med.tahun)}</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">${escapeHTML(med.keterangan)}</p>
                </div>
            `).join('') : '<p class="text-xs text-slate-400 italic">Belum ada catatan riwayat penyakit.</p>';

            // 5. Render Pengalaman Organisasi
            const elOrganisasi = document.getElementById('list-organisasi');
            elOrganisasi.innerHTML = appData.organisasi.length ? appData.organisasi.map(org => `
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-2">
                            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-lg bg-emerald-100 text-emerald-800">${escapeHTML(org.periode)}</span>
                        </div>
                        <h4 class="text-sm font-bold text-slate-900">${escapeHTML(org.nama)}</h4>
                        <p class="text-xs font-semibold text-emerald-600 mt-0.5">${escapeHTML(org.jabatan)}</p>
                        <p class="text-xs text-slate-600 mt-2 leading-relaxed">${escapeHTML(org.deskripsi)}</p>
                    </div>
                </div>
            `).join('') : '<p class="text-xs text-slate-400 italic">Belum ada pengalaman organisasi.</p>';

            // 6. Render Karya / Produk
            const elKarya = document.getElementById('list-karya');
            elKarya.innerHTML = appData.karya.length ? appData.karya.map(item => `
                <div class="p-5 rounded-xl bg-gradient-to-b from-white to-slate-50 border border-slate-200 hover:border-purple-400 transition-all shadow-sm flex flex-col justify-between">
                    <div>
                        <span class="inline-block text-[11px] font-bold px-2.5 py-1 rounded-lg bg-purple-100 text-purple-700 mb-3">
                            ${escapeHTML(item.kategori)}
                        </span>
                        <h4 class="text-base font-bold text-slate-900 mb-1.5">${escapeHTML(item.judul)}</h4>
                        <p class="text-xs text-slate-600 leading-relaxed mb-4">${escapeHTML(item.deskripsi)}</p>
                    </div>
                    ${item.link ? `
                        <a href="${escapeHTML(item.link)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-purple-600 hover:text-purple-800">
                            <span>Lihat Karya / Produk</span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                        </a>
                    ` : ''}
                </div>
            `).join('') : '<p class="text-xs text-slate-400 italic">Belum ada data karya atau produk.</p>';
        }

        function resetAllData() {
            appData = JSON.parse(JSON.stringify(defaultData));
            saveDataToStorage();
            renderAll();
            showToast('Seluruh data dikembalikan ke pengaturan awal.', 'info');
        }

        // Inisialisasi saat halaman dimuat
        window.addEventListener('DOMContentLoaded', () => {
            renderAll();
        });
    </script>
</body>
</html>
```
